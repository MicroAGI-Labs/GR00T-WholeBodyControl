{
  mode: "peer",
  listen: { endpoints: ["tcp/0.0.0.0:7447"] },
  scouting: { multicast: { enabled: false } },
  // This bridge crosses hosts through an SSH TCP tunnel.  Disable Zenoh shared
  // memory so forwarded DDS discovery can carry serialized Unitree LowState
  // samples even when the generated DDS type is not memcpy-safe.
  transport: { shared_memory: { enabled: false } },
  plugins: {
    dds: {
      domain: 1,
      allow: ["rt/lowstate", "rt/lowcmd", "rt/secondary_imu", "rt/reset_pose/cmd", "rt/eval", "rt/api/motion_switcher/request", "rt/api/motion_switcher/response"],
      forward_discovery: true
    }
  },
  open: {
    return_conditions: { "connect_scouted": false }
  }
}
